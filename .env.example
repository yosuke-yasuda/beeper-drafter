# Copy to .env and fill in. .env is gitignored.

# Required. Beeper Desktop > Settings > Integrations > Approved connections > (+), with "Allow sensitive actions" on.
BEEPER_TOKEN=

# AI: "codex" (OpenAI Codex CLI, any ChatGPT account) or "claude" (Claude Code, Pro/Max). Uses the CLI you're logged into.
# AI_PROVIDER=codex
# Model: leave empty for the CLI's default (Claude defaults to sonnet here).
# AI_MODEL=
# Thinking level. Codex: depends on the model (usually low..xhigh). Claude: low|medium|high|xhigh|max.
# AI_EFFORT=low

# Optional (defaults shown)
# DEBOUNCE_SECONDS=1.5
# RECONCILE_SECONDS=600
# HISTORY=20
# BEEPER_URL=http://localhost:23373
