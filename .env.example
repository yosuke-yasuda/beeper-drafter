# Copy to .env and fill in. .env is gitignored.

# Required. Beeper Desktop > Settings > Integrations > Approved connections > (+), with "Allow sensitive actions" on.
BEEPER_TOKEN=

# AI: "claude" (Claude Code) or "codex" (OpenAI Codex CLI). Uses the CLI you're logged into.
# AI_PROVIDER=claude
# AI_MODEL=sonnet
# Thinking level. Claude: low|medium|high|xhigh|max. Codex: depends on the model (usually low..xhigh).
# AI_EFFORT=low

# Optional (defaults shown)
# DEBOUNCE_SECONDS=1.5
# RECONCILE_SECONDS=600
# HISTORY=20
# BEEPER_URL=http://localhost:23373
