# Copy to .env and fill in. .env is gitignored.

# Required. Beeper Desktop > Settings > Integrations > Approved connections > (+), with "Allow sensitive actions" on.
BEEPER_TOKEN=

# AI: "codex" (OpenAI Codex CLI, any ChatGPT account) or "claude" (Claude Code, Pro/Max). Uses the CLI you're logged into.
# AI_PROVIDER=codex
# Model: leave empty for the CLI's default (Claude defaults to sonnet here).
# AI_MODEL=
# Thinking level. Codex: depends on the model (usually low..xhigh). Claude: low|medium|high|xhigh|max.
# AI_EFFORT=low

# System 1 gate (optional, off by default). A fast model scores "does this need a reply?" first;
# chats under the threshold are skipped without the full model. The full model can still skip the rest.
# SYSTEM1_PROVIDER=systemone   # systemone (Clef/Jev server) | openai (OpenAI-compatible API, incl. Ollama/LM Studio) | codex | claude
# SYSTEM1_URL=                 # systemone: http://localhost:30000, openai: https://api.openai.com/v1
# SYSTEM1_MODEL=               # systemone: Cloudflare/clef-flash, claude: haiku, openai: required
# SYSTEM1_API_KEY=             # for a remote server; openai also reads OPENAI_API_KEY
# SYSTEM1_EFFORT=              # codex/claude only
# SYSTEM1_THRESHOLD=0.3        # skip when P(needs reply) is below this
# SYSTEM1_HISTORY=10           # recent messages the gate sees (HISTORY is for the full model)
# SYSTEM1_TIMEOUT_SECONDS=15

# Optional (defaults shown)
# DEBOUNCE_SECONDS=1.5
# RECONCILE_SECONDS=600
# HISTORY=20
# BEEPER_URL=http://localhost:23373
